#!/usr/bin/env python3
"""Sync manifest.json and hacs.json with the constants of the custom component."""

import json
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parent.parent
COMPONENTS = ROOT / "custom_components"

packages = sorted(
    p for p in COMPONENTS.iterdir() if p.is_dir() and not p.name.startswith("__")
)
if not packages:
    sys.exit("No custom component found.")
if len(packages) > 1:
    print(
        f"WARNING: more than one custom component found, updating {packages[0].name} only."
    )
package = packages[0]

const = (package / "const.py").read_text(encoding="utf8")


def constant(name: str) -> str:
    """Return the value of a string constant from const.py."""
    match = re.search(rf'^{name}(?:: Final)? = "([^"]*)"', const, re.MULTILINE)
    if match is None:
        sys.exit(f"Constant {name} not found in {package / 'const.py'}")
    return match.group(1)


manifest_path = package / "manifest.json"
manifest = json.loads(manifest_path.read_text(encoding="utf8"))
manifest["domain"] = constant("DOMAIN")
manifest["name"] = constant("NAME")
manifest["version"] = constant("VERSION")
manifest["issue_tracker"] = constant("ISSUE_URL")
manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf8")

hacs_path = ROOT / "hacs.json"
hacs = json.loads(hacs_path.read_text(encoding="utf8"))
hacs["name"] = constant("NAME")
hacs_path.write_text(json.dumps(hacs, indent=2) + "\n", encoding="utf8")

print(f"Updated {manifest_path.relative_to(ROOT)} and {hacs_path.relative_to(ROOT)}")
